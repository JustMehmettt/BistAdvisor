@using BistAdvisor.Application.Dtos
@model List<SignalChangeDto>

@{
    ViewData["Title"] = "Sinyal Geçmişi";
}

<h1 class="mb-4">Sinyal Geçmişi</h1>

<form method="get" class="row g-2 mb-4" id="signal-filter-form">
    <div class="col-md-3">
        <div class="sc-combobox" data-auto-submit>
            <button type="button" class="sc-combobox-trigger" data-role="trigger">
                <span data-role="label">Tüm Sinyaller</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 9l5-5 5 5M7 15l5 5 5-5" stroke="#64748B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="sc-combobox-panel" data-role="panel">
                <input type="text" class="sc-combobox-search" data-role="search" placeholder="Sinyal ara..." autocomplete="off" />
                <ul class="sc-combobox-list" data-role="list">
                    <li class="sc-combobox-option" data-value="">Tüm Sinyaller</li>
                    <li class="sc-combobox-option" data-value="StrongBuy">Güçlü Al</li>
                    <li class="sc-combobox-option" data-value="Buy">Al</li>
                    <li class="sc-combobox-option" data-value="Neutral">Nötr</li>
                    <li class="sc-combobox-option" data-value="Sell">Sat</li>
                    <li class="sc-combobox-option" data-value="StrongSell">Güçlü Sat</li>
                </ul>
            </div>
            <input type="hidden" name="signalType" data-role="hidden" value="@ViewData["CurrentSignalType"]" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="sc-float-field">
            <input type="text" name="symbol" id="signal-symbol-input" placeholder=" " value="@ViewData["CurrentSymbol"]" />
            <label for="signal-symbol-input">Hisse/Şirket Ara</label>
        </div>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filtrele</button>
    </div>
</form>

<div id="signal-history-table-container">
    @await Html.PartialAsync("_SignalHistoryTable", Model)
</div>

@section Scripts {
    <script>
        let currentSignalType = '@ViewData["CurrentSignalType"]' || '';
        let currentSymbol = '@ViewData["CurrentSymbol"]' || '';

        async function loadSignalTable(page) {
            const form = document.getElementById('signal-filter-form');
            const formData = new FormData(form);
            const params = new URLSearchParams();

            for (const [key, value] of formData.entries()) {
                if (value) params.append(key, value);
            }

            params.append('page', page);

            const response = await fetch('/SignalHistory/Table?' + params.toString());
            const html = await response.text();

            document.getElementById('signal-history-table-container').innerHTML = html;
            attachSignalPaginationHandlers();

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function attachSignalPaginationHandlers() {
            document.querySelectorAll('.signal-pagination-link').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    const page = parseInt(link.getAttribute('data-page'));
                    loadSignalTable(page);
                });
            });
        }

        document.getElementById('signal-filter-form').addEventListener('submit', (e) => {
            e.preventDefault();
            loadSignalTable(1);
        });

        attachSignalPaginationHandlers();
    </script>
}