@using BistAdvisor.Application.Dtos
@model List<SignalChangeDto>

@{
    ViewData["Title"] = "Sinyal Geçmişi";
    var page = (int)(ViewData["Page"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);

    string PillClass(string signalType)
    {
        return signalType switch
        {
            "StrongBuy" or "Buy" => "pill-green",
            "Sell" or "StrongSell" => "pill-red",
            _ => "pill-gray"
        };
    }

    string GroupLabel(string signalType)
    {
        return signalType switch
        {
            "StrongBuy" => "Güçlü Al",
            "Buy" => "Al",
            "Neutral" => "Nötr",
            "Sell" => "Sat",
            "StrongSell" => "Güçlü Sat",
            _ => signalType
        };
    }
}

<h1 class="mb-4">Sinyal Geçmişi</h1>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <div class="sc-combobox" data-auto-submit>
            <button type="button" class="sc-combobox-trigger" data-role="trigger">
                <span data-role="label">Tüm Sinyaller</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 9l5-5 5 5M7 15l5 5 5-5" stroke="#64748B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="sc-combobox-panel" data-role="panel">
                <input type="text" class="sc-combobox-search" data-role="search" placeholder="Sinyal ara..." autocomplete="off" />
                <ul class="sc-combobox-list" data-role="list">
                    <li class="sc-combobox-option" data-value="">Tüm Sinyaller</li>
                    <li class="sc-combobox-option" data-value="StrongBuy">Güçlü Al</li>
                    <li class="sc-combobox-option" data-value="Buy">Al</li>
                    <li class="sc-combobox-option" data-value="Neutral">Nötr</li>
                    <li class="sc-combobox-option" data-value="Sell">Sat</li>
                    <li class="sc-combobox-option" data-value="StrongSell">Güçlü Sat</li>
                </ul>
            </div>
            <input type="hidden" name="signalType" data-role="hidden" value="@ViewData["CurrentSignalType"]" />
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Henüz sinyal değişikliği kaydı bulunmuyor.</div>
}
else
{
    <table class="table-dynamic">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Hisse</th>
                <th>Şirket</th>
                <th>Önceki Sinyal</th>
                <th>Yeni Sinyal</th>
                <th>Önceki Skor</th>
                <th>Yeni Skor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var change in Model)
            {
                <tr>
                    <td>@change.ChangeTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td><a href="/Stocks/Detail/@change.Symbol" class="text-decoration-none" style="color:#0A8DD0; font-weight:600;">@change.Symbol</a></td>
                    <td>@change.CompanyName</td>
                    <td><span class="pill @PillClass(change.PreviousSignalType)">@GroupLabel(change.PreviousSignalType)</span></td>
                    <td><span class="pill @PillClass(change.NewSignalType)">@GroupLabel(change.NewSignalType)</span></td>
                    <td>@(change.PreviousScore?.ToString("F2") ?? "-")</td>
                    <td>@(change.NewScore?.ToString("F2") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (totalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" href="/SignalHistory?page=@i&signalType=@ViewData["CurrentSignalType"]">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}