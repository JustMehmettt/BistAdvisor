@using BistAdvisor.Application.Dtos
@model List<StockListItemDto>

@{
    ViewData["Title"] = "Hisseler";
    var sectors = ViewData["Sectors"] as List<string?> ?? new List<string?>();
}

<h1 class="mb-4">Hisse Listesi</h1>

<form method="get" class="row g-2 mb-4" id="filter-form">
    <div class="col-md-2">
        <input type="text" name="search" class="form-control" placeholder="Hisse/şirket ara..."
               value="@ViewData["CurrentSearch"]" />
    </div>
    <div class="col-md-2">
        <div class="sc-combobox">
            <button type="button" class="sc-combobox-trigger" data-role="trigger">
                <span data-role="label">Tüm Sektörler</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 9l5-5 5 5M7 15l5 5 5-5" stroke="#64748B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="sc-combobox-panel" data-role="panel">
                <input type="text" class="sc-combobox-search" data-role="search" placeholder="Sektör ara..." autocomplete="off" />
                <ul class="sc-combobox-list" data-role="list">
                    <li class="sc-combobox-option" data-value="">Tüm Sektörler</li>
                    @foreach (var sector in sectors)
                    {
                        <li class="sc-combobox-option" data-value="@sector">@sector</li>
                    }
                </ul>
            </div>
            <input type="hidden" name="sector" data-role="hidden" value="@ViewData["CurrentSector"]" />
        </div>
    </div>
    <div class="col-md-2">
        <div class="sc-combobox">
            <button type="button" class="sc-combobox-trigger" data-role="trigger">
                <span data-role="label">Tüm Sinyaller</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 9l5-5 5 5M7 15l5 5 5-5" stroke="#64748B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="sc-combobox-panel" data-role="panel">
                <input type="text" class="sc-combobox-search" data-role="search" placeholder="Sinyal ara..." autocomplete="off" />
                <ul class="sc-combobox-list" data-role="list">
                    <li class="sc-combobox-option" data-value="">Tüm Sinyaller</li>
                    <li class="sc-combobox-option" data-value="StrongBuy">Güçlü Al</li>
                    <li class="sc-combobox-option" data-value="Buy">Al</li>
                    <li class="sc-combobox-option" data-value="Neutral">Nötr</li>
                    <li class="sc-combobox-option" data-value="Sell">Sat</li>
                    <li class="sc-combobox-option" data-value="StrongSell">Güçlü Sat</li>
                </ul>
            </div>
            <input type="hidden" name="signalType" data-role="hidden" value="@ViewData["CurrentSignalType"]" />
        </div>
    </div>
    <div class="col-md-2">
        <input type="number" name="minScore" class="form-control" placeholder="Min. Skor"
               value="@ViewData["CurrentMinScore"]" />
    </div>
    <div class="col-md-2">
        <input type="number" name="minConfidence" class="form-control" placeholder="Min. Güven %"
               value="@ViewData["CurrentMinConfidence"]" />
    </div>
    <div class="col-md-1 d-flex align-items-center">
        <div class="form-check">
            <input type="checkbox" name="hideStale" value="true" class="form-check-input" id="hideStaleCheck"
                   checked="@((bool)(ViewData["CurrentHideStale"] ?? false))" />
            <label class="form-check-label small" for="hideStaleCheck">Güncel Olmayan Gizle</label>
        </div>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100">Filtrele</button>
    </div>
</form>

<div id="stock-table-container">
    @await Html.PartialAsync("_StockTable", Model)
</div>

@section Scripts {
    <script>
        let currentSortBy = '@ViewData["CurrentSortBy"]' || 'symbol';
        let currentSortDir = '@ViewData["CurrentSortDir"]' || 'asc';

        async function loadTable(sortBy, sortDir) {
            const form = document.getElementById('filter-form');
            const formData = new FormData(form);
            const params = new URLSearchParams();

            for (const [key, value] of formData.entries()) {
                if (value) params.append(key, value);
            }

            params.append('sortBy', sortBy);
            params.append('sortDir', sortDir);

            const response = await fetch('/Stocks/Table?' + params.toString());
            const html = await response.text();

            document.getElementById('stock-table-container').innerHTML = html;
            currentSortBy = sortBy;
            currentSortDir = sortDir;
            attachSortHandlers();
        }

        function attachSortHandlers() {
            document.querySelectorAll('.sort-link').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    const column = link.getAttribute('data-column');
                    const newDir = (currentSortBy === column && currentSortDir === 'asc') ? 'desc' : 'asc';
                    loadTable(column, newDir);
                });
            });
        }

        document.getElementById('filter-form').addEventListener('submit', (e) => {
            e.preventDefault();
            loadTable(currentSortBy, currentSortDir);
        });

        attachSortHandlers();
    </script>
}