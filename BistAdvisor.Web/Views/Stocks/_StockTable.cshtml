@using BistAdvisor.Application.Dtos
@model List<StockListItemDto>

@{
    var currentSortBy = ViewData["CurrentSortBy"]?.ToString() ?? "symbol";
    var currentSortDir = ViewData["CurrentSortDir"]?.ToString() ?? "asc";

    string PillClass(string signalType)
    {
        return signalType switch
        {
            "StrongBuy" or "Buy" => "pill-green",
            "Sell" or "StrongSell" => "pill-red",
            _ => "pill-gray"
        };
    }
}

<table class="table-dynamic">
    <thead>
    <tr>
        <th>
            <a href="#" class="sort-link text-decoration-none" style="color:#222;" data-column="symbol">Hisse</a>
            @if (currentSortBy == "symbol") { @(currentSortDir == "asc" ? "▲" : "▼") }
        </th>
        <th>
            <a href="#" class="sort-link text-decoration-none" style="color:#222;" data-column="companyname">Şirket</a>
            @if (currentSortBy == "companyname") { @(currentSortDir == "asc" ? "▲" : "▼") }
        </th>
        <th>
            <a href="#" class="sort-link text-decoration-none" style="color:#222;" data-column="sector">Sektör</a>
            @if (currentSortBy == "sector") { @(currentSortDir == "asc" ? "▲" : "▼") }
        </th>
        <th>
            <a href="#" class="sort-link text-decoration-none" style="color:#222;" data-column="lastprice">Son Fiyat</a>
            @if (currentSortBy == "lastprice") { @(currentSortDir == "asc" ? "▲" : "▼") }
        </th>
        <th>
            <a href="#" class="sort-link text-decoration-none" style="color:#222;" data-column="dailychangerate">Günlük Değişim</a>
            @if (currentSortBy == "dailychangerate") { @(currentSortDir == "asc" ? "▲" : "▼") }
        </th>
        <th>
            <a href="#" class="sort-link text-decoration-none" style="color:#222;" data-column="rsivalue">RSI</a>
            @if (currentSortBy == "rsivalue") { @(currentSortDir == "asc" ? "▲" : "▼") }
        </th>
        <th>MACD</th>
        <th>EMA Trendi</th>
        <th>
            <a href="#" class="sort-link text-decoration-none" style="color:#222;" data-column="totalscore">Skor</a>
            @if (currentSortBy == "totalscore") { @(currentSortDir == "asc" ? "▲" : "▼") }
        </th>
        <th>
            <a href="#" class="sort-link text-decoration-none" style="color:#222;" data-column="confidencerate">Güven Oranı</a>
            @if (currentSortBy == "confidencerate") { @(currentSortDir == "asc" ? "▲" : "▼") }
        </th>
        <th>
            <a href="#" class="sort-link text-decoration-none" style="color:#222;" data-column="signaltype">Sinyal</a>
            @if (currentSortBy == "signaltype") { @(currentSortDir == "asc" ? "▲" : "▼") }
        </th>
        <th>
            <a href="#" class="sort-link text-decoration-none" style="color:#222;" data-column="lastupdate">Son Güncelleme</a>
            @if (currentSortBy == "lastupdate") { @(currentSortDir == "asc" ? "▲" : "▼") }
        </th>
    </tr>
    </thead>
    <tbody>
    @foreach (var stock in Model)
    {
        var badgeClass = stock.SignalType switch
        {
            "StrongBuy" => "pill-green",
            "Buy" => "pill-green",
            "Sell" => "pill-red",
            "StrongSell" => "pill-red",
            _ => "pill-gray"
        };

        var changeColor = stock.DailyChangeRate switch
        {
            > 0 => "#1E9E4A",
            < 0 => "#D6373E",
            _ => "#222"
        };

        <tr>
            <td><a href="/Stocks/Detail/@stock.Symbol" class="text-decoration-none" style="color:#0A8DD0; font-weight:600;">@stock.Symbol</a></td>
            <td>@stock.CompanyName</td>
            <td>@stock.Sector</td>
            <td>@(stock.LastPrice?.ToString("F2") ?? "-")</td>
            <td style="color:@changeColor;">@(stock.DailyChangeRate.HasValue ? $"{stock.DailyChangeRate:F2}%" : "-")</td>
            <td>@(stock.RsiValue?.ToString("F1") ?? "-")</td>
            <td>@(stock.MacdStatus ?? "-")</td>
            <td>@(stock.EmaTrend ?? "-")</td>
            <td>@(stock.TotalScore?.ToString("F2") ?? "-")</td>
            <td>@(stock.ConfidenceRate?.ToString("F1") + "%")</td>
            <td><span class="pill @badgeClass">@stock.SignalType</span></td>
            <td>@(stock.LastUpdate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
        </tr>
    }
    </tbody>
</table>

@{
    var currentPageNum = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPagesNum = (int)(ViewData["TotalPages"] ?? 1);
    var totalCountNum = (int)(ViewData["TotalCount"] ?? 0);
}
<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted small">Toplam @totalCountNum hisse, @totalPagesNum sayfa</span>
    <nav>
        <ul class="pagination mb-0">
            @for (var i = 1; i <= totalPagesNum; i++)
            {
                <li class="page-item @(i == currentPageNum ? "active" : "")">
                    <a href="#" class="page-link pagination-link" data-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>