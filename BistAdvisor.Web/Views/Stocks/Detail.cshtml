@using BistAdvisor.Application.Dtos
@model StockDetailDto

@{
ViewData["Title"] = $"{Model.Symbol} - Detay";

var badgeClass = Model.SignalType switch
{
"StrongBuy" => "pill-green",
"Buy" => "pill-green",
"Sell" => "pill-red",
"StrongSell" => "pill-red",
_ => "pill-gray"
};
}

<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;600&display=swap" rel="stylesheet">
<style>
    .chartjs-card {
        background: #fff;
        border: 1px solid #E5E5E5;
        border-radius: 8px;
        padding: 20px;
        font-family: 'Roboto', sans-serif;
    }
    .chartjs-card h6 {
        font-family: 'Roboto', sans-serif;
        font-weight: 600;
        font-size: 14px;
        color: #474747;
        text-align: center;
        margin-bottom: 12px;
    }
</style>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1>@Model.Symbol <small class="text-muted fs-4">@Model.CompanyName</small></h1>
        <span class="badge bg-light text-dark">@Model.Sector</span>
    </div>
    <span class="pill @badgeClass fs-5">@Model.SignalType</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="text-muted">Son Fiyat</h6>
                <h3>@(Model.LastPrice?.ToString("F2") ?? "-")</h3>
                @if (Model.DailyChangeRate.HasValue)
                {
                    var changeColor = Model.DailyChangeRate > 0 ? "#1E9E4A" : Model.DailyChangeRate < 0 ? "#D6373E" : "#222";
                    <div class="small" style="color:@changeColor;">@Model.DailyChangeRate?.ToString("F2")%</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="text-muted">Teknik Skor</h6>
                <h3>@(Model.TotalScore?.ToString("F2") ?? "-")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="text-muted">Güven Oranı</h6>
                <h3>@(Model.ConfidenceRate?.ToString("F1") + "%")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="text-muted">Son Güncelleme</h6>
                <h6 class="mt-2">@(Model.LastUpdate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</h6>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Explanation))
{
    <div class="alert alert-light border">
        <strong>Sinyal Gerekçesi:</strong> @Model.Explanation
        @if (!string.IsNullOrWhiteSpace(Model.AlgorithmVersion))
        {
            <div class="text-muted small mt-1"><strong>Algoritma Versiyonu:</strong> @Model.AlgorithmVersion</div>        }
    </div>
}

<h4 class="mt-4">Fiyat Grafiği (Mum Grafiği)</h4>
<div class="chartjs-card">
    <canvas id="priceChart" height="90"></canvas>
</div>

<h4 class="mt-4">EMA / Bollinger Bantları</h4>
<div class="chartjs-card">
    <canvas id="emaChart" height="90"></canvas>
</div>

<div class="row mt-5">
    <div class="col-md-6">
        <div class="chartjs-card">
            <h6>RSI</h6>
            <canvas id="rsiChart" height="140"></canvas>
        </div>
    </div>
    <div class="col-md-6">
        <div class="chartjs-card">
            <h6>Stochastic Oscillator</h6>
            <canvas id="stochasticChart" height="140"></canvas>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="chartjs-card h-100">
            <h6>MACD</h6>
            <canvas id="macdChart" height="140"></canvas>
        </div>
    </div>
    <div class="col-md-6">
        <div class="chartjs-card h-100">
            <h6>İndikatör Bazlı Puan Dağılımı</h6>
            <table class="table-dynamic">
                <thead>
                <tr>
                    <th>İndikatör</th>
                    <th>Puan</th>
                </tr>
                </thead>
                <tbody>
                @{
                    var scoreRows = new (string Name, int? Score)[]
                    {
                        ("RSI", Model.RsiScore),
                        ("MACD", Model.MacdScore),
                        ("EMA", Model.EmaScore),
                        ("Bollinger", Model.BollingerScore),
                        ("Stochastic", Model.StochasticScore)
                    };
                }
                @foreach (var row in scoreRows)
                {
                    var rowClass = row.Score switch
                    {
                        > 0 => "pill-green",
                        < 0 => "pill-red",
                        0 => "pill-gray",
                        _ => "pill-gray"
                    };

                    <tr>
                        <td>@row.Name</td>
                        <td><span class="pill @rowClass">@(row.Score?.ToString() ?? "-")</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<h4 class="mt-5">Sinyal Geçmişi</h4>
<table class="table-dynamic">
    <thead>
    <tr>
        <th>Tarih</th>
        <th>Sinyal</th>
        <th>Skor</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.SignalHistory)
    {
    <tr>
        <td>@item.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
        <td>@item.SignalType</td>
        <td>@(item.TotalScore?.ToString("F2") ?? "-")</td>
    </tr>
    }
    </tbody>
</table>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.0/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-chart-financial/dist/chartjs-chart-financial.min.js"></script>
<script>
    const candleData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.PriceHistory.Select(p => new {
    x = p.Date.ToUnixTimeMilliseconds(),
    o = p.Open,
    h = p.High,
    l = p.Low,
    c = p.Close
    })));

    const indicatorLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.Date.ToUnixTimeMilliseconds())));
    const ema20Data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.Ema20)));
    const ema50Data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.Ema50)));
    const bollUpperData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.BollingerUpper)));
    const bollMiddleData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.BollingerMiddle)));
    const bollLowerData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.BollingerLower)));
    const rsiData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.RsiValue)));
    const macdLineData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.MacdValue)));
    const macdSignalData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.MacdSignalValue)));
    const macdHistogramData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.MacdHistogramValue)));
    const stochKData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.StochasticK)));
    const stochDData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.IndicatorHistory.Select(p => p.StochasticD)));

    function toTimeSeries(values) {
        return values.map((v, i) => ({ x: indicatorLabels[i], y: v }));
    }

    Chart.defaults.font.family = 'Roboto';
    Chart.defaults.color = '#474747';

    new Chart(document.getElementById('priceChart'), {
        type: 'candlestick',
        data: {
            datasets: [{
                label: '@Model.Symbol',
                data: candleData,
                color: { up: '#27AE60', down: '#EB5757', unchanged: '#949499' },
                borderColor: { up: '#27AE60', down: '#EB5757', unchanged: '#949499' }
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { type: 'time', time: { unit: 'day' }, grid: { color: '#B0B0B0' } },
                y: { grid: { color: '#B0B0B0' } }
            }
        }
    });

    new Chart(document.getElementById('emaChart'), {
        type: 'line',
        data: {
            datasets: [
                { label: 'EMA20', data: toTimeSeries(ema20Data), borderColor: '#FBE38E', backgroundColor: '#FBE38E', pointRadius: 3, pointBackgroundColor: '#FBE38E', borderWidth: 2, tension: 0.2 },
                { label: 'EMA50', data: toTimeSeries(ema50Data), borderColor: '#9A89FF', backgroundColor: '#9A89FF', pointRadius: 3, pointBackgroundColor: '#9A89FF', borderWidth: 2, tension: 0.2 },
                { label: 'Bollinger Üst', data: toTimeSeries(bollUpperData), borderColor: '#EB5757', pointRadius: 0, borderDash: [4, 4], borderWidth: 1, tension: 0.2 },
                { label: 'Bollinger Orta', data: toTimeSeries(bollMiddleData), borderColor: '#B0B0B0', pointRadius: 0, borderDash: [4, 4], borderWidth: 1, tension: 0.2 },
                { label: 'Bollinger Alt', data: toTimeSeries(bollLowerData), borderColor: '#27AE60', pointRadius: 0, borderDash: [4, 4], borderWidth: 1, tension: 0.2 }
            ]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: true, position: 'bottom', labels: { font: { size: 12 } } } },
            scales: {
                x: { type: 'time', time: { unit: 'day' }, grid: { color: '#B0B0B0' } },
                y: { grid: { color: '#B0B0B0' } }
            }
        }
    });

    new Chart(document.getElementById('rsiChart'), {
        type: 'line',
        data: {
            datasets: [{ label: 'RSI', data: toTimeSeries(rsiData), borderColor: '#9A89FF', backgroundColor: '#9A89FF', pointRadius: 3, pointBackgroundColor: '#9A89FF', borderWidth: 2, tension: 0.2 }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { type: 'time', time: { unit: 'day' }, grid: { color: '#B0B0B0' } },
                y: { min: 0, max: 100, ticks: { stepSize: 10 }, grid: { color: '#B0B0B0' } }
            }
        }
    });

    new Chart(document.getElementById('stochasticChart'), {
        type: 'line',
        data: {
            datasets: [
                { label: '%K', data: toTimeSeries(stochKData), borderColor: '#FBE38E', backgroundColor: '#FBE38E', pointRadius: 3, pointBackgroundColor: '#FBE38E', borderWidth: 2, tension: 0.2 },
                { label: '%D', data: toTimeSeries(stochDData), borderColor: '#9A89FF', backgroundColor: '#9A89FF', pointRadius: 3, pointBackgroundColor: '#9A89FF', borderWidth: 2, tension: 0.2 }
            ]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: true, position: 'bottom' } },
            scales: {
                x: { type: 'time', time: { unit: 'day' }, grid: { color: '#B0B0B0' } },
                y: { min: 0, max: 100, ticks: { stepSize: 10 }, grid: { color: '#B0B0B0' } }
            }
        }
    });

    new Chart(document.getElementById('macdChart'), {
        data: {
            datasets: [
                { type: 'bar', label: 'Histogram', data: toTimeSeries(macdHistogramData), backgroundColor: '#B0B0B0' },
                { type: 'line', label: 'MACD', data: toTimeSeries(macdLineData), borderColor: '#9A89FF', pointRadius: 0, borderWidth: 2, tension: 0.2 },
                { type: 'line', label: 'Sinyal', data: toTimeSeries(macdSignalData), borderColor: '#EB5757', pointRadius: 0, borderWidth: 2, tension: 0.2 }
            ]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: true, position: 'bottom' } },
            scales: {
                x: { type: 'time', time: { unit: 'day' }, grid: { color: '#B0B0B0' } },
                y: { grid: { color: '#B0B0B0' } }
            }
        }
    });
</script>
}
