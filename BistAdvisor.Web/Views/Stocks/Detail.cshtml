@using BistAdvisor.Application.Dtos
@model StockDetailDto

@{
    ViewData["Title"] = $"{Model.Symbol} - Detay";

    var badgeClass = Model.SignalType switch
    {
        "StrongBuy" => "pill-green",
        "Buy" => "pill-green",
        "Sell" => "pill-red",
        "StrongSell" => "pill-red",
        _ => "pill-gray"
    };
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1>@Model.Symbol <small class="text-muted fs-4">@Model.CompanyName</small></h1>
        <span class="badge bg-light text-dark">@Model.Sector</span>
    </div>
    <span class="pill @badgeClass fs-5">@Model.SignalType</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="text-muted">Son Fiyat</h6>
                <h3>@(Model.LastPrice?.ToString("F2") ?? "-")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="text-muted">Teknik Skor</h6>
                <h3>@(Model.TotalScore?.ToString("F2") ?? "-")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="text-muted">Güven Oranı</h6>
                <h3>@(Model.ConfidenceRate?.ToString("F1") + "%")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="text-muted">Son Güncelleme</h6>
                <h6 class="mt-2">@(Model.LastUpdate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</h6>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Explanation))
{
    <div class="alert alert-light border">
        <strong>Sinyal Gerekçesi:</strong> @Model.Explanation
    </div>
}

<h4 class="mt-4">Fiyat Grafiği</h4>
<div style="background:#FCFCFC; border-radius:8px; padding:16px;">
    <canvas id="priceChart" height="90"></canvas>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <h5>MACD</h5>
        <canvas id="macdChart" height="120"></canvas>
    </div>
    <div class="col-md-6">
        <h5>İndikatör Bazlı Puan Dağılımı</h5>
        <canvas id="scoreChart" height="120"></canvas>
    </div>
</div>

<h4 class="mt-5">Sinyal Geçmişi</h4>
<table class="table-dynamic">
    <thead>
    <tr>
        <th>Tarih</th>
        <th>Sinyal</th>
        <th>Skor</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.SignalHistory)
    {
        <tr>
            <td>@item.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
            <td>@item.SignalType</td>
            <td>@(item.TotalScore?.ToString("F2") ?? "-")</td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.0/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-chart-financial/dist/chartjs-chart-financial.min.js"></script>
    <script>
        const candleData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.PriceHistory.Select(p => new {
        x = p.Date.ToUnixTimeMilliseconds(),
        o = p.Open,
        h = p.High,
        l = p.Low,
        c = p.Close
        })));

        new Chart(document.getElementById('priceChart'), {
            type: 'candlestick',
            data: {
                datasets: [{
                    label: '@Model.Symbol',
                    data: candleData,
                    color: {
                        up: '#27AE60',
                        down: '#EB5757',
                        unchanged: '#949499'
                    },
                    borderColor: {
                        up: '#27AE60',
                        down: '#EB5757',
                        unchanged: '#949499'
                    }
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {display: false}
                },
                scales: {
                    x: {
                        type: 'time',
                        time: {unit: 'day'},
                        ticks: {color: '#222222'},
                        grid: {color: 'rgba(0,0,0,0.06)'}
                    },
                    y: {
                        ticks: {color: '#222222'},
                        grid: {color: 'rgba(0,0,0,0.06)'}
                    }
                }
            }
        });

        new Chart(document.getElementById('rsiChart'), {
            type: 'line',
            data: {
                labels: indicatorLabels,
                datasets: [{ label: 'RSI', data: rsiData, borderColor: '#0A8DD0', pointRadius: 0, borderWidth: 2, tension: 0.2 }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { min: 0, max: 100, ticks: { stepSize: 10 } } }
            }
        });

        new Chart(document.getElementById('stochasticChart'), {
            type: 'line',
            data: {
                labels: indicatorLabels,
                datasets: [
                    { label: '%K', data: stochKData, borderColor: '#0A8DD0', pointRadius: 0, borderWidth: 2, tension: 0.2 },
                    { label: '%D', data: stochDData, borderColor: '#F5A623', pointRadius: 0, borderWidth: 2, tension: 0.2 }
                ]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: true, position: 'bottom' } },
                scales: { y: { min: 0, max: 100, ticks: { stepSize: 10 } } }
            }
        });

        new Chart(document.getElementById('macdChart'), {
            data: {
                labels: indicatorLabels,
                datasets: [
                    { type: 'bar', label: 'Histogram', data: macdHistogramData, backgroundColor: '#DBDBDB' },
                    { type: 'line', label: 'MACD', data: macdLineData, borderColor: '#0A8DD0', pointRadius: 0, borderWidth: 2, tension: 0.2 },
                    { type: 'line', label: 'Sinyal', data: macdSignalData, borderColor: '#D6373E', pointRadius: 0, borderWidth: 2, tension: 0.2 }
                ]
            },
            options: { responsive: true, plugins: { legend: { display: true, position: 'bottom' } } }
        });
        
        new Chart(document.getElementById('scoreChart'), {
            type: 'bar',
            data: {
                labels: ['RSI', 'MACD', 'EMA', 'Bollinger', 'Stochastic'],
                datasets: [{
                    label: 'Puan',
                    data: [
                        @(Model.RsiScore ?? 0), @(Model.MacdScore ?? 0), @(Model.EmaScore ?? 0),
                        @(Model.BollingerScore ?? 0), @(Model.StochasticScore ?? 0)
                    ],
                    backgroundColor: [
                        @(Model.RsiScore ?? 0) >= 0 ? "'#D4F8D3'" : "'#FBE7E9'",
                        @(Model.MacdScore ?? 0) >= 0 ? "'#D4F8D3'" : "'#FBE7E9'",
                        @(Model.EmaScore ?? 0) >= 0 ? "'#D4F8D3'" : "'#FBE7E9'",
                        @(Model.BollingerScore ?? 0) >= 0 ? "'#D4F8D3'" : "'#FBE7E9'",
                        @(Model.StochasticScore ?? 0) >= 0 ? "'#D4F8D3'" : "'#FBE7E9'"
                    ]
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { min: -2, max: 2, ticks: { stepSize: 1 } } }
            }
        });
    </script>
}