@using BistAdvisor.Domain.Entities
@{
    ViewData["Title"] = "Yönetim Paneli";
    var stocks = ViewData["Stocks"] as List<Stock> ?? new List<Stock>();
    var recentLogs = ViewData["RecentLogs"] as List<DataFetchLog> ?? new List<DataFetchLog>();
    var failedLogs = ViewData["FailedLogs"] as List<DataFetchLog> ?? new List<DataFetchLog>();
}

<h1 class="mb-4">Yönetim ve Log Sayfası</h1>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <button type="button" class="btn btn-primary w-100" id="btn-sync" onclick="runAdminAction('RunDataSync', 'btn-sync', 'msg-sync')">
            <span class="spinner-border spinner-border-sm d-none" id="spinner-sync"></span>
            Veri Toplamayı Şimdi Çalıştır
        </button>
        <div class="small mt-1" id="msg-sync"></div>
    </div>
    <div class="col-md-4">
        <button type="button" class="btn btn-success w-100" id="btn-bulletin" onclick="runAdminAction('GenerateBulletin', 'btn-bulletin', 'msg-bulletin')">
            <span class="spinner-border spinner-border-sm d-none" id="spinner-bulletin"></span>
            Bülteni Şimdi Oluştur
        </button>
        <div class="small mt-1" id="msg-bulletin"></div>
    </div>
    <div class="col-md-4">
        <button type="button" class="btn btn-secondary w-100" id="btn-test" onclick="runAdminAction('TestConnection', 'btn-test', 'msg-test')">
            <span class="spinner-border spinner-border-sm d-none" id="spinner-test"></span>
            Veri Kaynağı Bağlantı Testi
        </button>
        <div class="small mt-1" id="msg-test"></div>
    </div>
</div>

<h4 class="mt-5">İndikatör Ağırlıkları</h4>
<table class="table table-sm w-auto">
    <tbody>
        <tr><td>MACD</td><td>%25</td></tr>
        <tr><td>EMA20/EMA50</td><td>%25</td></tr>
        <tr><td>RSI</td><td>%20</td></tr>
        <tr><td>Bollinger Bantları</td><td>%15</td></tr>
        <tr><td>Stochastic Oscillator</td><td>%15</td></tr>
    </tbody>
</table>

<h4 class="mt-5">Hisse Yönetimi</h4>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Kod</th>
            <th>Şirket</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stock in stocks)
        {
            <tr id="stock-row-@stock.Id">
                <td>@stock.Symbol</td>
                <td>@stock.CompanyName</td>
                <td>
                    <span class="badge @(stock.IsActive ? "bg-success" : "bg-secondary")" id="stock-badge-@stock.Id">
                        @(stock.IsActive ? "Aktif" : "Pasif")
                    </span>
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="stock-btn-@stock.Id"
                            onclick="toggleStock(@stock.Id)">
                        <span class="spinner-border spinner-border-sm d-none" id="stock-spinner-@stock.Id"></span>
                        <span id="stock-btn-text-@stock.Id">@(stock.IsActive ? "Pasif Yap" : "Aktif Yap")</span>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<h4 class="mt-5">Son Çalışan Görevler</h4>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Hisse</th>
            <th>Başlangıç</th>
            <th>Durum</th>
            <th>Eklenen Kayıt</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in recentLogs)
        {
            <tr>
                <td>@(log.Stock?.Symbol ?? "-")</td>
                <td>@log.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                <td>
                    <span class="badge @(log.Status == JobStatus.Success ? "bg-success" : "bg-danger")">
                        @log.Status
                    </span>
                </td>
                <td>@log.InsertedRowCount</td>
            </tr>
        }
    </tbody>
</table>

@if (failedLogs.Count > 0)
{
    <h4 class="mt-5 text-danger">Hatalı Görevler</h4>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Hisse</th>
                <th>Başlangıç</th>
                <th>Hata Mesajı</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in failedLogs)
            {
                <tr>
                    <td>@(log.Stock?.Symbol ?? "-")</td>
                    <td>@log.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td class="text-danger small">@log.ErrorMessage</td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        async function runAdminAction(actionName, buttonId, messageId) {
            const button = document.getElementById(buttonId);
            const spinner = document.getElementById('spinner-' + buttonId.replace('btn-', ''));
            const messageEl = document.getElementById(messageId);

            button.disabled = true;
            spinner.classList.remove('d-none');
            messageEl.textContent = '';
            messageEl.className = 'small mt-1';

            try {
                const response = await fetch('/Admin/' + actionName, { method: 'POST' });
                const data = await response.json();

                const text = `${data.message} (${data.durationSeconds} s)`;
                const cssClass = 'small mt-1 ' + (data.success ? 'text-success' : 'text-danger');

                if (actionName === 'RunDataSync' || actionName === 'GenerateBulletin') {
                    sessionStorage.setItem('adminMessage', text);
                    sessionStorage.setItem('adminMessageClass', cssClass);
                    sessionStorage.setItem('adminMessageTarget', messageId);
                    window.location.reload();
                } else {
                    messageEl.textContent = text;
                    messageEl.className = cssClass;
                }
            } catch (err) {
                messageEl.textContent = 'İşlem sırasında bir hata oluştu.';
                messageEl.className = 'small mt-1 text-danger';
            } finally {
                button.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        async function toggleStock(stockId) {
            const button = document.getElementById('stock-btn-' + stockId);
            const spinner = document.getElementById('stock-spinner-' + stockId);
            const badge = document.getElementById('stock-badge-' + stockId);
            const btnText = document.getElementById('stock-btn-text-' + stockId);

            button.disabled = true;
            spinner.classList.remove('d-none');

            try {
                const response = await fetch('/Admin/ToggleStock?stockId=' + stockId, { method: 'POST' });
                const data = await response.json();

                if (data.success) {
                    if (data.isActive) {
                        badge.textContent = 'Aktif';
                        badge.className = 'badge bg-success';
                        btnText.textContent = 'Pasif Yap';
                    } else {
                        badge.textContent = 'Pasif';
                        badge.className = 'badge bg-secondary';
                        btnText.textContent = 'Aktif Yap';
                    }
                }
            } catch (err) {
                alert('İşlem sırasında bir hata oluştu.');
            } finally {
                button.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const savedMessage = sessionStorage.getItem('adminMessage');
            const savedClass = sessionStorage.getItem('adminMessageClass');
            const savedTarget = sessionStorage.getItem('adminMessageTarget');

            if (savedMessage && savedTarget) {
                const targetEl = document.getElementById(savedTarget);
                if (targetEl) {
                    targetEl.textContent = savedMessage;
                    targetEl.className = savedClass;
                }

                sessionStorage.removeItem('adminMessage');
                sessionStorage.removeItem('adminMessageClass');
                sessionStorage.removeItem('adminMessageTarget');
            }
        });
    </script>
}